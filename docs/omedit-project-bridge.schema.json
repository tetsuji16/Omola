{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tetsuji16/Omola/blob/main/docs/omedit-project-bridge.schema.json",
  "title": "Omola project inspection bridge",
  "description": "Validated project data emitted for the native OMEdit integration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "manifest_path",
    "project_root",
    "schema_version",
    "name",
    "model_file",
    "entry_model",
    "package_roots",
    "dependencies",
    "simulation"
  ],
  "properties": {
    "format_version": { "const": 1 },
    "manifest_path": { "type": "string", "minLength": 1 },
    "project_root": { "type": "string", "minLength": 1 },
    "schema_version": { "const": 1 },
    "name": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "model_file": { "type": "string", "minLength": 1 },
    "entry_model": { "type": "string", "minLength": 1 },
    "package_roots": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 }
        }
      }
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stop_time", "parameters"],
      "properties": {
        "stop_time": { "type": "number", "exclusiveMinimum": 0 },
        "parameters": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        }
      }
    }
  }
}
